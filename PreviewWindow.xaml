<Window x:Class="NINA.Plugin.InternalGuider.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internal Guider - Aperçu" Width="1120" Height="980" MinWidth="700" MinHeight="600"
        Background="#FF2F3A3D" Foreground="#FFE8E8E8"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Icônes vectorielles des boutons : estompées quand le bouton est désactivé -->
        <Style x:Key="IconCanvas" TargetType="Canvas">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                <Button Margin="0,0,0,0" Padding="12,8" IsEnabled="{Binding CanCalibrate}" Click="Calibrate_Click"
                        ToolTip="Calibrer : mesure la direction et la vitesse des deux axes de la monture. Ctrl + clic : pointe d'abord l'équateur céleste, 1 h après le méridien, puis calibre."
                        AutomationProperties.Name="Calibrer">
                    <Viewbox Width="44" Height="44">
                        <Canvas Width="24" Height="24" Style="{StaticResource IconCanvas}">
                            <!-- deux axes perpendiculaires terminés par des flèches -->
                            <Path Stroke="#FF7FD0FF" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,3 V21 M3,12 H21 M9,6 L12,3 L15,6 M9,18 L12,21 L15,18 M6,9 L3,12 L6,15 M18,9 L21,12 L18,15" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Margin="32,0,0,0" Padding="12,8" IsEnabled="{Binding CanGuide}" Click="Guide_Click"
                        ToolTip="Guider : verrouille l'étoile choisie et corrige la monture"
                        AutomationProperties.Name="Guider">
                    <Viewbox Width="44" Height="44">
                        <Canvas Width="24" Height="24" Style="{StaticResource IconCanvas}">
                            <!-- étoile verrouillée dans un viseur à quatre coins -->
                            <Path Stroke="#FF5BD18B" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16" />
                            <Path Fill="#FF5BD18B"
                                  Data="M12,7 L13.29,10.22 L16.76,10.46 L14.09,12.68 L14.94,16.05 L12,14.2 L9.06,16.05 L9.91,12.68 L7.24,10.46 L10.71,10.22 Z" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Margin="32,0,0,0" Padding="12,8" IsEnabled="{Binding CanStop}" Click="Stop_Click"
                        ToolTip="Stop : arrête la calibration en cours, ou le guidage en cours"
                        AutomationProperties.Name="Stop">
                    <Viewbox Width="44" Height="44">
                        <Canvas Width="24" Height="24" Style="{StaticResource IconCanvas}">
                            <Rectangle Canvas.Left="5" Canvas.Top="5" Width="14" Height="14" RadiusX="2.5" RadiusY="2.5" Fill="#FFE5675B" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Margin="32,0,0,0" Padding="12,8" Click="Advanced_Click"
                        ToolTip="Paramètres avancés : simulation, bibliothèque de darks, journal"
                        AutomationProperties.Name="Paramètres avancés">
                    <Viewbox Width="44" Height="44">
                        <Canvas Width="24" Height="24" Style="{StaticResource IconCanvas}">
                            <!-- trois curseurs de réglage -->
                            <Path Stroke="#FFE8E8E8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3,6 H21 M3,12 H21 M3,18 H21" />
                            <Ellipse Canvas.Left="5.4" Canvas.Top="3.4" Width="5.2" Height="5.2" Fill="#FFF2C14E" Stroke="#FF2F3A3D" StrokeThickness="1" />
                            <Ellipse Canvas.Left="13.4" Canvas.Top="9.4" Width="5.2" Height="5.2" Fill="#FFF2C14E" Stroke="#FF2F3A3D" StrokeThickness="1" />
                            <Ellipse Canvas.Left="7.4" Canvas.Top="15.4" Width="5.2" Height="5.2" Fill="#FFF2C14E" Stroke="#FF2F3A3D" StrokeThickness="1" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Margin="32,0,0,0" Padding="12,8" IsEnabled="{Binding CanCalibrate}" Click="Assistant_Click"
                        ToolTip="Assistant de guidage : mesure la dérive, le seeing, l'erreur périodique et le jeu en Dec, puis suggère des réglages"
                        AutomationProperties.Name="Assistant de guidage">
                    <Viewbox Width="44" Height="44">
                        <Canvas Width="24" Height="24" Style="{StaticResource IconCanvas}">
                            <!-- courbe de mesure sur des axes -->
                            <Path Stroke="#FFE8E8E8" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M3,3 V21 H21" />
                            <Path Stroke="#FFF2C14E" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5,16 L8,10 L11,14 L14,7 L17,11 L20,5" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <TextBlock Text="SIMULATION" Foreground="#FFFF8A5C" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding Simulation, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Pose (s) :" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding ExposureChoices}"
                          SelectedItem="{Binding Exposure}" Width="70" />
                <TextBlock Text="Gain :" VerticalAlignment="Center" Margin="24,0,6,0" />
                <TextBox x:Name="GainBox" Text="{Binding GainText, UpdateSourceTrigger=LostFocus}" Width="60"
                         IsEnabled="{Binding CanSetGain}" KeyDown="GainBox_KeyDown"
                         ToolTip="Entrée pour valider. Appliqué à la prochaine pose et mémorisé pour cette caméra." />
                <TextBlock Text="{Binding GainRangeText}" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7" />
                <Button Content="Auto" Margin="10,0,0,0" Padding="22,2" MinWidth="84" Click="AutoGain_Click" IsEnabled="{Binding CanAutoGain}"
                        ToolTip="Gain automatique : cherche le gain le plus élevé qui ne sature aucune étoile (environ 30 s, sur le champ visé, pose actuelle). Propose de créer le dark manquant." />
            </StackPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Agressivité RA (%) :" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding AggressivenessChoices}"
                          SelectedItem="{Binding AggressivenessRaPercent}" Width="60" />
                <TextBlock Text="Dec (%) :" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox ItemsSource="{Binding AggressivenessChoices}"
                          SelectedItem="{Binding AggressivenessDecPercent}" Width="60" />
                <TextBlock Text="Hystérésis RA (%) :" VerticalAlignment="Center" Margin="24,0,6,0" />
                <TextBox Text="{Binding HysteresisRaText, UpdateSourceTrigger=LostFocus}" Width="40"
                         ToolTip="0 = aucune. Mélange la correction précédente avec la nouvelle (lisse le bruit, ajoute du retard). Max 90." />
                <TextBlock Text="Dec (%) :" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox Text="{Binding HysteresisDecText, UpdateSourceTrigger=LostFocus}" Width="40"
                         ToolTip="0 = aucune. Max 90." />
                <TextBlock Text="Max RA (ms) :" VerticalAlignment="Center" Margin="24,0,6,0" />
                <TextBox Text="{Binding MaxRaDurationText, UpdateSourceTrigger=LostFocus}" Width="55"
                         ToolTip="Durée maximale d'une impulsion de correction en RA" />
                <TextBlock Text="Max Dec (ms) :" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox Text="{Binding MaxDecDurationText, UpdateSourceTrigger=LostFocus}" Width="55"
                         ToolTip="Durée maximale d'une impulsion de correction en Dec" />
                <!-- Groupe insécable : passe en bloc à la ligne suivante si la fenêtre est trop étroite -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Guider en Dec :" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <CheckBox IsChecked="{Binding GuideDec}" VerticalAlignment="Center"
                              ToolTip="ON : corrige aussi en déclinaison. OFF : corrige seulement en RA." />
                    <TextBlock Text="Sens Dec :" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <ComboBox ItemsSource="{Binding DecModeOptions}" SelectedItem="{Binding SelectedDecMode}" Width="130"
                              ToolTip="Nord seul / Sud seul : aucune correction dans l'autre sens (évite le jeu à l'inversion)." />
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="{Binding StatusDisplay}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding GuideStats}" TextWrapping="Wrap" />
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Padding="24,2" MinWidth="100" Content="{Binding GraphUnitText}" Click="GraphUnit_Click"
                        ToolTip="Basculer entre pixels et secondes d'arc" />
                <TextBlock Text="Historique :" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox ItemsSource="{Binding HistoryOptions}" SelectedItem="{Binding SelectedHistory}" Width="70"
                          ToolTip="Nombre de corrections affichées" />
                <TextBlock Text="Échelle ±" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}" Width="70"
                          ToolTip="Amplitude verticale du graphe" />
                <TextBlock Text="{Binding GraphScaleUnit}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <Button Padding="24,2" MinWidth="100" Content="Effacer" Margin="16,0,0,0" Click="GraphClear_Click"
                        ToolTip="Efface le graphe et les statistiques RMS" />
                <TextBlock Text="Contraste :" VerticalAlignment="Center" Margin="24,0,6,0" />
                <ComboBox ItemsSource="{Binding StretchOptions}" SelectedItem="{Binding SelectedStretch}" Width="90"
                          ToolTip="Contraste de l'image d'aperçu : Fort et Très fort font ressortir les étoiles faibles (sans effet sur le guidage)." />
                <StackPanel Orientation="Horizontal" Visibility="{Binding MonoMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Images de NINA :" VerticalAlignment="Center" Margin="24,0,6,0" />
                    <CheckBox IsChecked="{Binding LiveView}" VerticalAlignment="Center"
                              ToolTip="Caméra unique : ON affiche ici les images prises par NINA (poses, mise au point, astrométrie) sans que le plugin ne touche à la caméra. Le guidage et la calibration ne prennent la caméra que quand vous les lancez." />
                </StackPanel>
                <TextBlock Text="FWHM :" VerticalAlignment="Center" Margin="24,0,6,0" />
                <CheckBox IsChecked="{Binding ShowFwhm}" VerticalAlignment="Center"
                          ToolTip="ON : affiche le FWHM moyen des étoiles (estimé à partir du HFD : 0,94 x HFD), en pixels et en secondes d'arc." />
                <TextBlock Text="{Binding FwhmText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="Panneau latéral :" VerticalAlignment="Center" Margin="24,0,6,0" />
                <CheckBox IsChecked="{Binding ShowStarProfile}" VerticalAlignment="Center"
                          ToolTip="Affiche à droite de l'image deux onglets : le profil de l'étoile de guidage (zoom, profil, historique du HFD, mesures) et le bilan de la dernière calibration." />
            </WrapPanel>
            <Image Source="{Binding GraphImage}" Height="170" Stretch="Fill" Margin="0,4,0,0" />
        </StackPanel>
        <!-- Profil de l'étoile (équivalent de PHD2) : zoom, profil radial avec gaussienne, historique du HFD, mesures -->
        <Border DockPanel.Dock="Right" Width="296" Margin="8,0,0,0" Padding="8" Background="#FF262F31"
                Visibility="{Binding ShowStarProfile, Converter={StaticResource BoolToVis}}">
            <TabControl SelectedIndex="{Binding SideTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0,6,0,0">
              <TabItem Header="Profil de l'étoile">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="Black" BorderBrush="#FF55666A" BorderThickness="1">
                    <Image Source="{Binding StarZoomImage}" Width="258" Height="258" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="Linear"
                           ToolTip="Zoom sur l'étoile de guidage (21 x 21 pixels, contraste propre à l'étoile). La croix verte marque le centre mesuré." />
                </Border>
                <TextBlock Text="Profil radial (blanc : pixels · cyan : gaussienne de même FWHM · jaune : mi-hauteur)" FontSize="10" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,2" />
                <Image Source="{Binding StarCurveImage}" Width="258" Stretch="Uniform"
                       ToolTip="Si les points blancs sont plus larges que la courbe cyan, l'étoile est floue ou allongée ; un pic plus haut et plus étroit signale une meilleure mise au point." />
                <TextBlock Text="Historique du HFD (le plus bas est le mieux)" FontSize="10" Opacity="0.7" Margin="0,8,0,2" />
                <Image Source="{Binding StarHistoryImage}" Width="258" Stretch="Uniform"
                       ToolTip="Dernières 120 images. Pour la mise au point, cherchez le point où cette courbe est la plus basse." />
                <TextBlock Text="{Binding StarProfileText}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
              </TabItem>
              <TabItem Header="Bilan calibration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding CalibrationHeader}" FontSize="10" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <Border Background="Black" BorderBrush="#FF55666A" BorderThickness="1">
                            <Image Source="{Binding CalibrationPlotImage}" Width="258" Height="258" Stretch="Uniform"
                                   ToolTip="Déplacement de l'étoile dans le repère de l'image (x vers la droite, y vers le bas) pendant les impulsions RA (vert) et Dec (rouge). Deux droites bien droites et perpendiculaires signalent une bonne calibration." />
                        </Border>
                        <ItemsControl ItemsSource="{Binding CalibrationRows}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,5">
                                        <TextBlock Text="{Binding Label}" FontSize="10" Opacity="0.65" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
        </Border>
        <Border Background="Black" ClipToBounds="True">
            <!-- Hôte du zoom : molette = zoom, glisser = déplacer, clic milieu = ajuster, clic gauche = choisir l'étoile, clic droit = automatique -->
            <Grid x:Name="ImageHost" Background="Transparent" ClipToBounds="True"
                  MouseWheel="ImageHost_MouseWheel"
                  MouseLeftButtonDown="ImageHost_LeftDown" MouseLeftButtonUp="ImageHost_LeftUp"
                  MouseMove="ImageHost_MouseMove" MouseDown="ImageHost_MouseDown"
                  SizeChanged="ImageHost_SizeChanged">
                <Image x:Name="StarImage" Source="{Binding Image}" Stretch="Uniform" Cursor="Cross"
                       RenderTransformOrigin="0,0"
                       ToolTip="Clic gauche : choisir l'étoile de guidage · Clic droit : sélection automatique">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="ZoomShift" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="ZoomHint" Margin="6,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                           IsHitTestVisible="False" Opacity="0.75" FontSize="11"
                           Text="Molette : zoom · glisser : déplacer · clic milieu : ajuster" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
