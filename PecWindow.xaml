<Window x:Class="NINA.Plugin.InternalGuider.PecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internal Guider - Analyse du PEC" Width="980" Height="880" MinWidth="640" MinHeight="520"
        Background="#FF2F3A3D" Foreground="#FFE8E8E8"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Padding="24,4" MinWidth="100" Content="Fermer" IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="260" />
                <RowDefinition Height="8" />
                <RowDefinition Height="3*" MinHeight="140" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#FF55646A" BorderThickness="1" Background="#FF263033">
                <Canvas x:Name="ChartHost" ClipToBounds="True" SizeChanged="ChartHost_SizeChanged" />
            </Border>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ReportPanel" Margin="2,0,10,0" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
