<Window x:Class="NINA.Plugin.InternalGuider.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Internal Guider - Assistant de guidage" Width="760" Height="720"
        Background="#FF2F3A3D" Foreground="#FFE8E8E8"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Padding="24,4" MinWidth="170" x:Name="ApplyButton" Content="Appliquer les réglages" IsEnabled="False" Click="Apply_Click"
                    ToolTip="Applique le mouvement minimal, les impulsions maximales et le sens Dec suggérés" />
            <Button Padding="24,4" MinWidth="100" x:Name="CloseButton" Content="Fermer" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="La monture suit sans recevoir de correction pendant la durée choisie : l'assistant mesure la dérive de chaque axe, le bruit de seeing, l'erreur périodique en RA et l'alignement polaire (dérive en Dec), puis suggère des réglages. Pointez de préférence une région dégagée près du méridien et de l'équateur céleste, monture en suivi, après une calibration." />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Durée :" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="DurationBox" Width="110"
                          ToolTip="2 à 5 min : dérive et bruit. 10 min ou plus : mesure aussi l'erreur périodique (2 périodes)." />
                <CheckBox x:Name="BacklashBox" Content="Mesurer le jeu en Dec" IsChecked="True" VerticalAlignment="Center" Margin="24,0,0,0"
                          ToolTip="Envoie ensuite des impulsions Nord puis Sud (environ 1 à 2 minutes) : l'étoile se déplace de quelques dizaines de pixels." />
                <Button Padding="24,4" MinWidth="100" x:Name="StartButton" Content="Démarrer" Margin="24,0,0,0" Click="Start_Click" />
                <Button Padding="24,4" MinWidth="100" x:Name="StopButton" Content="Interrompre" Margin="8,0,0,0" IsEnabled="False" Click="Stop_Click" />
            </StackPanel>
            <TextBlock x:Name="ProgressText" Margin="0,14,0,6" TextWrapping="Wrap" Text=" " />
            <ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="1" />
        </StackPanel>
        <TextBox x:Name="ReportBox" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 Background="#FF263033" Foreground="#FFE8E8E8" BorderBrush="#FF55646A" Padding="8" />
    </DockPanel>
</Window>
